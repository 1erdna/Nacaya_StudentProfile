<?xml version='1.0' encoding='utf-8'?>

<widget
    id="com.student.profile"
    version="1.0.0"
    xmlns="http://www.w3.org/ns/widgets"
    xmlns:cdv="http://cordova.apache.org/ns/1.0"
    xmlns:android="http://schemas.android.com/apk/res/android"
>

    <name>StudentProfile</name>

    <description>
        Activity 7 Student Profile with Authentication and Database Integration
    </description>

    <author>
        Andrei Jullian Nacaya
    </author>

    <!-- Activity 7 starts on the login page -->
    <content src="login.html" />

    <!-- Allow application network access -->
    <access origin="*" />

    <!-- Allow HTTP and HTTPS navigation -->
    <allow-navigation href="http://*/*" />
    <allow-navigation href="https://*/*" />

    <!-- Allow normal web intents -->
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />

    <!-- Allow local file access used by Cordova -->
    <allow-intent href="file:///*" />

    <!-- =====================================================
         ANDROID CONFIGURATION
         ===================================================== -->

    <platform name="android">

        <!-- Gradle version required by our Cordova Android setup -->
        <preference
            name="GradleVersion"
            value="8.14.2"
        />

        <!--
            Allows Cordova to operate in insecure file mode
            during local Activity 7 development/testing.
        -->
        <preference
            name="AndroidInsecureFileModeEnabled"
            value="true"
        />

        <!-- Allow the Android WebView to call the local HTTP backend -->
        <edit-config
            file="app/src/main/AndroidManifest.xml"
            mode="merge"
            target="/manifest/application"
        >
            <application
                android:usesCleartextTraffic="true"
            />
        </edit-config>

    </platform>

</widget>
